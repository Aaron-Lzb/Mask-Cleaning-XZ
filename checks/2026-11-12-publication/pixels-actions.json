[["eval", "(async()=>{const results=[];for(const [view,t] of [['iso',40],['top',83],['cleaner',115],['grip',58],['iso',100],['iso',201]]){cleaning.setView(view);cleaning.seek(t);const canvas=document.getElementById('machine'),copy=document.createElement('canvas');copy.width=canvas.width;copy.height=canvas.height;const g=copy.getContext('2d');g.drawImage(canvas,0,0);const hash=await crypto.subtle.digest('SHA-256',g.getImageData(0,0,copy.width,copy.height).data);results.push({view,t,width:copy.width,height:copy.height,sha256:Array.from(new Uint8Array(hash),x=>x.toString(16).padStart(2,'0')).join('')});}return JSON.stringify(results)})()"]]